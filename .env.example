# Required: Solana donor secret key. Two formats are accepted:
#   - JSON array of 64 bytes (Solana CLI / `solana-keygen new -o id.json` format):
#       DONATION_PRIVATE_KEY=[12,34,...,255]
#   - Base58-encoded 64-byte secret (Phantom export format):
#       DONATION_PRIVATE_KEY=4xZ...
# SOL is NOT required in this wallet — the x402 facilitator pays gas. USDC is.
DONATION_PRIVATE_KEY=

# Required: Solana wallet address (base58 pubkey) of the charity receiving donations.
CHARITY_WALLET=

# Optional: Display name for the charity (default: My Charity)
CHARITY_NAME=Give Directly

# Optional: Description of the charity
CHARITY_DESCRIPTION=Donations to Give Directly

# Optional: solana-mainnet or solana-devnet (default: solana-devnet)
# NOTE: the default facilitator (https://x402.org/facilitator) currently only
# advertises Solana DEVNET. If you set DONATION_NETWORK=solana-mainnet you must
# also set FACILITATOR_URL to a facilitator that supports Solana mainnet
# (e.g. PayAI: https://facilitator.payai.network) or the server will exit with
# "Facilitator does not support scheme 'exact' on network 'solana:5ey...'".
DONATION_NETWORK=solana-devnet

# Optional: override the x402 facilitator URL. Defaults to https://x402.org/facilitator.
# Set this for solana-mainnet, or to use your own facilitator deployment.
FACILITATOR_URL=

# Optional: Public URL of your server (auto-detected on Vercel)
BASE_URL=http://localhost:3402

# Optional: Server port (default: 3402)
PORT=3402

# Optional but RECOMMENDED for production: Secret key to protect POST /donate.
# Without this, anyone who knows your server URL can trigger donations.
# Generate one with: openssl rand -hex 32
DONATE_API_KEY=

# Optional: Comma-separated allowed CORS origins (default: * = all origins)
# CORS_ORIGINS=https://myapp.com,https://admin.myapp.com
